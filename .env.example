# Plantilla de desarrollo local. Copiar a .env y ajustar:
#   cp .env.example .env
#
# Única variable que lee este repo: VITE_DEV_BACKEND_URL (vite.config.js).
# No hay variables de stage/producción: los prefijos de backend son constantes
# de ruta en src/config.ts y el ruteo por dominio lo resuelve Traefik, así que
# la misma imagen Docker sirve para cualquier entorno sin inyectar nada al
# arrancar el contenedor.

# Único destino del server.proxy de vite.config.js: un host ya fronteado por
# Traefik (igual que stage/producción) para que resuelva por path los prefijos
# /auth-service y /identity/api/v1. El dev server los reenvía sin
# reescribirlos, igual que Traefik con un dominio real.
VITE_DEV_BACKEND_URL=https://devflow.guinealab.duckdns.org:9865
