PORT=
# Local development only (see src/config.ts).
VITE_AUTH_URL=
VITE_API_URL=
VITE_IDENTITY_API_URL=

# Stage/production only. These are NOT read by Vite — they are consumed by
# docker-entrypoint.sh at container start, which renders them into
# /config.json (fetched by the app at boot, see src/config.ts).
# Set to the backends' absolute URLs, e.g.:
#   AUTH_URL=https://auth.example.com
#   API_URL=https://api.b-mori.example.com
#   IDENTITY_API_URL=https://identity.example.com
AUTH_URL=
API_URL=
IDENTITY_API_URL=
