PORT=
# Local development only (see vite.config.js's server.proxy + src/config.ts).
# One single URL is enough: it must be a host already fronted by Traefik
# (same as stage/production) so it resolves /auth-service and
# /identity/api/v1 by path — the dev server just forwards those prefixes to
# it unchanged, same as Traefik does for a real domain.
VITE_DEV_BACKEND_URL=https://devflow.guinealab.duckdns.org:9865

# Stage/production: no hay variables que setear aquí. AUTH_URL/
# IDENTITY_API_URL son prefijos de ruta fijos hardcodeados en
# src/config.ts (/auth-service, /identity/api/v1), y Traefik (labels en el
# repo de cada backend) los enruta por dominio según el Host de la petición.
# API_URL no tiene prefijo asignado todavía porque b-mori no tiene backend
# propio aún.
